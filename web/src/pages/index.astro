---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import { Image } from 'astro:assets';
import { getAssetImagePath } from '@src/utils/general';
import { MTA_CURRENT_VERSION } from '@src/content.constants';
import { Card, CardGrid, LinkButton  } from '@astrojs/starlight/components';
import IconLinkCard from '@src/components/IconLinkCard.astro';


           // <li><a href={"/Changes_in_"+MTA_CURRENT_VERSION.full}>Changes in {MTA_CURRENT_VERSION.full}</a></li>
                    


---

<StarlightPage frontmatter={{
    template: 'doc',
    tableOfContents: false,
    title: 'Multi Theft Auto: Wiki',
    head: [
        {
            tag: 'title',
            content: 'Multi Theft Auto: Wiki',
        }
    ],
}}>

<div class="mainpage">
    <div class="header">
        <Image src={getAssetImagePath("mta_logo.png")} alt="Multi Theft Auto Logo"/>

        <div class="header-text">
            <h1>Welcome to the Multi Theft Auto Documentation</h1>
            <span>On this wiki you'll find a wealth of information on using <i>Multi Theft Auto</i>.</span>
            
            <div class="header-buttons">
                <LinkButton href="https://multitheftauto.com/" icon="download" iconPlacement='start'>Download MTA SA {MTA_CURRENT_VERSION.full}</LinkButton>
                <LinkButton href="https://github.com/multitheftauto/mtasa-blue" icon="github" iconPlacement='start' variant='secondary'>View on GitHub</LinkButton>
            </div>
        </div>
    </div>

    <div class="content">
        <CardGrid>
            <Card title="Community" icon="heart">
                <IconLinkCard title="Help Center" href="https://help.multitheftauto.com" icon="open-book"/>
                <IconLinkCard title="Development Discord" href="https://discord.com/invite/GNN6PRtTnu" icon="discord"/>
                <IconLinkCard title="ModDB" href="https://www.moddb.com/mods/multi-theft-auto-san-andreas" icon="mastodon"/>
                <IconLinkCard title="MTA Community" href="https://community.multitheftauto.com/" description='Share and download resources.' icon="external"/>
                <IconLinkCard title="RW Tool" href="https://nightly.mtasa.com/rwtool/" icon="setting" />
            </Card>

            <Card title="Developing Multi Theft Auto" icon="information">
                <IconLinkCard title="Nightly builds" href="https://nightly.mtasa.com/" icon="cloud-download"/>
                <IconLinkCard title="Roadmap" href="https://github.com/multitheftauto/mtasa-blue/milestones" icon="github"/>
                <IconLinkCard title="Bugtracker" href="https://github.com/multitheftauto/mtasa-blue/issues" icon="laptop"/>
                <IconLinkCard title="Contributing guidelines" href="https://github.com/multitheftauto/mtasa-docs/blob/main/mtasa-blue/CONTRIBUTING.md" icon="seti:notebook"/>
            
                <div class="mta-opensource-info">
                    <Image style={{ width: '50px', height: '50px' }} src={getAssetImagePath("osi_symbol.png")} alt="Open Source Initiative"/>
                    <div style="display: flex; flex-direction: column;">
                        <span><b>Multi Theft Auto</b> is <b>Open Source</b></span>
                        <span>This means anyone can contribute to making Multi Theft Auto even better!</span>
                    </div>
                </div>
            </Card>

        </CardGrid>
    </div>
</div>

<style>
.mainpage {
    display: flex;
    flex-direction: column;
    gap: 30px;
}

.header {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-direction: row;
    gap: 10%;
    text-align: left;
}

.header img {
    max-width: 180px;
    height: auto;
}

.header-text {
    display: flex;
    flex-direction: column;
    gap: 10px;
}

.header-buttons {
    display: flex;
    flex-direction: row;
    flex-wrap: wrap;
    gap: 20px;
    align-items: center;
}

.content {
    display: flex;
    justify-content: center;
    align-items: center;
}

.mta-opensource-info {
    display: flex;
    flex-direction: row;
    align-items: center;
    font-size: 16px;
    gap: 20px;
}

@media (max-width: 768px) {
    .header {
        flex-direction: column;
        text-align: center;
        gap: 20px;
    }

    .header-buttons {
        justify-content: center;
    }

    .header-text {
        align-items: center;
    }
}
</style>